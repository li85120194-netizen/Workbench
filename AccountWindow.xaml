<Window x:Class="Workbench.AccountWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="账户与个人中心" Width="500" Height="520" MinWidth="460" MinHeight="480"
 WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F7FD"
 FontFamily="Microsoft YaHei UI">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="BorderBrush" Value="#D7E2F1"/><Setter Property="Background" Value="White"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,6,0,12"/><Setter Property="BorderBrush" Value="#D7E2F1"/><Setter Property="Background" Value="White"/></Style>
  <Style x:Key="AccountButton" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="110"/><Setter Property="Padding" Value="18,0"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#2D7EF2"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="SecondaryAccountButton" TargetType="Button" BasedOn="{StaticResource AccountButton}"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#324765"/><Setter Property="BorderBrush" Value="#D7E2F1"/><Setter Property="BorderThickness" Value="1"/></Style>
 </Window.Resources>
 <Grid Margin="30,24">
  <StackPanel x:Name="AuthPanel">
   <TextBlock Text="本机账户" FontSize="26" FontWeight="Bold" Foreground="#10213B"/>
   <TextBlock Text="登录不是必需的；登录后可分别保存主题、计时器和侧栏偏好。" Foreground="#72829A" TextWrapping="Wrap" Margin="0,6,0,18"/>
   <TabControl x:Name="AuthTabs" Background="Transparent" BorderThickness="0">
    <TabItem Header="登录">
     <StackPanel Margin="8,18,8,0">
      <TextBlock Text="账户名" Foreground="#40516D"/><TextBox x:Name="LoginUsername"/>
      <TextBlock Text="密码" Foreground="#40516D"/><PasswordBox x:Name="LoginPassword"/>
      <TextBlock x:Name="LoginMessage" Foreground="#D64550" TextWrapping="Wrap" MinHeight="22"/>
      <Button Content="登录" Style="{StaticResource AccountButton}" HorizontalAlignment="Left" Click="Login_Click"/>
     </StackPanel>
    </TabItem>
    <TabItem Header="注册">
     <StackPanel Margin="8,16,8,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,7,0"><TextBlock Text="账户名" Foreground="#40516D"/><TextBox x:Name="RegisterUsername"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="显示名称" Foreground="#40516D"/><TextBox x:Name="RegisterDisplayName"/></StackPanel>
      </Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,7,0"><TextBlock Text="密码（至少 6 位）" Foreground="#40516D"/><PasswordBox x:Name="RegisterPassword"/></StackPanel>
       <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="确认密码" Foreground="#40516D"/><PasswordBox x:Name="RegisterPasswordAgain"/></StackPanel>
      </Grid>
      <TextBlock x:Name="RegisterMessage" Foreground="#D64550" TextWrapping="Wrap" MinHeight="22"/>
      <Button Content="创建并登录" Style="{StaticResource AccountButton}" HorizontalAlignment="Left" Click="Register_Click"/>
     </StackPanel>
    </TabItem>
   </TabControl>
   <Border Background="#EAF3FF" CornerRadius="9" Padding="14" Margin="8,18,8,0"><TextBlock Text="账户、密码哈希、头像和设置仅保存在这台电脑，不会上传网络。" Foreground="#42648F" TextWrapping="Wrap"/></Border>
  </StackPanel>

  <StackPanel x:Name="ProfilePanel" Visibility="Collapsed">
   <TextBlock Text="个人中心" FontSize="26" FontWeight="Bold" Foreground="#10213B"/>
   <TextBlock Text="修改头像和名称，并管理当前本机登录状态。" Foreground="#72829A" Margin="0,6,0,22"/>
   <Grid Margin="0,4,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Width="88" Height="88"><Ellipse x:Name="ProfileAvatar" Fill="#DCEAFF"/><TextBlock x:Name="ProfileInitial" Text="用" FontSize="30" FontWeight="Bold" Foreground="#2D73DC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="ProfileUsername" FontSize="14" Foreground="#7A899F"/><Button Content="更换头像" Style="{StaticResource SecondaryAccountButton}" Click="ChooseAvatar_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel>
   </Grid>
   <TextBlock Text="显示名称" Foreground="#40516D"/><TextBox x:Name="ProfileDisplayName"/>
   <TextBlock x:Name="ProfileMessage" Foreground="#D64550" TextWrapping="Wrap" MinHeight="24"/>
   <WrapPanel Margin="-4,12,0,0"><Button Content="保存个人资料" Style="{StaticResource AccountButton}" Click="SaveProfile_Click"/><Button Content="退出登录" Style="{StaticResource SecondaryAccountButton}" Click="Logout_Click"/></WrapPanel>
  </StackPanel>
 </Grid>
</Window>
