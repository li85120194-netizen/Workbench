<Window x:Class="Workbench.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="32" Height="32" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" ResizeMode="NoResize">
    <Grid x:Name="VisualRoot" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="PulseScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
        <Ellipse x:Name="Glow" StrokeThickness="0" Fill="Transparent" />
        <Ellipse x:Name="Ring" Stroke="#FFFF0000" StrokeThickness="3.2" Fill="Transparent" Margin="3" />
        <Rectangle x:Name="Square" Stroke="#FFFF0000" StrokeThickness="3.2" Fill="Transparent" Margin="3" Visibility="Collapsed"/>
        <Line x:Name="HorizontalMark" X1="0" X2="12" Y1="0" Y2="0" StrokeThickness="2"
              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <Line x:Name="VerticalMark" X1="0" X2="0" Y1="0" Y2="12" StrokeThickness="2"
              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        <Ellipse x:Name="CenterDot" Width="5" Height="5" HorizontalAlignment="Center"
                 VerticalAlignment="Center" Visibility="Collapsed" />
    </Grid>
</Window>
