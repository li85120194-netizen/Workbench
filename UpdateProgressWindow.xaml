<Window x:Class="Workbench.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小二更新" Width="540" Height="390" MinWidth="500" MinHeight="390"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Background="#F4F6FA" Closing="Window_Closing">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="正在更新小二" FontSize="24" FontWeight="SemiBold" Foreground="#172033"/>
        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,8,0,18"
                   Text="正在连接 GitHub…" Foreground="#687386" FontSize="14"
                   TextWrapping="Wrap"/>

        <ProgressBar x:Name="DownloadProgressBar" Grid.Row="2" Height="18"
                     Minimum="0" Maximum="100" IsIndeterminate="True"/>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DownloadedText" Text="准备下载完整安装包…" Foreground="#39445A"
                       TextWrapping="Wrap" Margin="0,0,16,0"/>
            <TextBlock x:Name="PercentText" Grid.Column="1" Text="--%" FontWeight="SemiBold" Foreground="#1677FF"/>
        </Grid>

        <Border Grid.Row="4" Margin="0,16,0,16" Padding="14" MinHeight="78"
                CornerRadius="8" Background="White" BorderBrush="#E5EAF1" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="下载速度" Foreground="#7A8496" FontSize="12"/>
                    <TextBlock x:Name="SpeedText" Text="--" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="已用时间" Foreground="#7A8496" FontSize="12"/>
                    <TextBlock x:Name="ElapsedText" Text="00:00" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="预计剩余" Foreground="#7A8496" FontSize="12"/>
                    <TextBlock x:Name="RemainingText" Text="计算中…" Margin="0,5,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="#EAF2FF" BorderBrush="#D7E5F8" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,0,0,14" VerticalAlignment="Top">
            <TextBlock Text="下载完成后会自动启动安装程序；安装结束后将重新打开小二。"
                       Foreground="#53657E" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="6" MinHeight="36">
            <TextBlock Text="更新期间可以继续查看进度，也可以随时取消。"
                       VerticalAlignment="Center" Foreground="#7A8496" FontSize="11"
                       TextWrapping="Wrap" Margin="0,0,116,0"/>
            <Button x:Name="CancelButton" Content="取消更新" Width="96" Height="34"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
