<Window x:Class="Workbench.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="工具箱" Width="1280" Height="820" MinWidth="1080" MinHeight="700"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="#DCE5F1" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
 Closing="Window_Closing" SourceInitialized="Window_SourceInitialized" StateChanged="Window_StateChanged">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="7" CornerRadius="16"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#10243F" Offset="0"/><GradientStop Color="#153152" Offset="0.58"/><GradientStop Color="#0F2441" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ActiveNavBrush" StartPoint="0,0" EndPoint="1,0">
   <GradientStop Color="#2875E8" Offset="0"/><GradientStop Color="#244F9B" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#3989FF" Offset="0"/><GradientStop Color="#1765EA" Offset="1"/>
  </LinearGradientBrush>

  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Height" Value="50"/><Setter Property="Margin" Value="16,2"/><Setter Property="Padding" Value="18,0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="15"/>
   <Setter Property="Foreground" Value="#D9E8FC"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="4,0,0,0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="NavBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
      <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#24466F"/><Setter Property="Foreground" Value="White"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Opacity" Value="0.82"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Height" Value="42"/><Setter Property="MinWidth" Value="116"/><Setter Property="Margin" Value="4"/>
   <Setter Property="Padding" Value="16,0"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#324765"/><Setter Property="Background" Value="#FAFCFF"/>
   <Setter Property="BorderBrush" Value="#D7E2F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#80ADFA"/><Setter TargetName="ButtonBorder" Property="Background" Value="#F2F7FF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
   <Setter Property="BorderBrush" Value="#2070EF"/>
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
   <Setter Property="Foreground" Value="#C83C49"/><Setter Property="Background" Value="#FFF7F8"/><Setter Property="BorderBrush" Value="#F1CCD1"/>
  </Style>
  <Style x:Key="TitleButton" TargetType="Button">
   <Setter Property="Width" Value="48"/><Setter Property="Height" Value="42"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#14233A"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="TitleButtonBorder" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TitleButtonBorder" Property="Background" Value="#E6EDF7"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="TitleButtonBorder" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CloseTitleButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E84555"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
  </Style>

  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Padding" Value="24"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Background" Value="#FCFEFF"/>
   <Setter Property="BorderBrush" Value="#E6EDF7"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#0E1D35"/></Style>
  <Style x:Key="PageSubtitle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#73829C"/><Setter Property="Margin" Value="0,7,0,0"/></Style>
  <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#15233B"/></Style>
  <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="#7B8AA4"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#40516D"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="11,7"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="Foreground" Value="#1B2A42"/><Setter Property="Background" Value="#FAFCFF"/>
   <Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="TextBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
     <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#5B96F5"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.55"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="9,4"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#1B2A42"/><Setter Property="Background" Value="#FAFCFF"/>
   <Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="11,8"/><Setter Property="Foreground" Value="#263750"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EAF2FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#DCEAFF"/><Setter Property="Foreground" Value="#1765EA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboBorder" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="8"><Grid><ContentPresenter Margin="12,0,38,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/><Path Data="M 0 0 L 5 5 L 10 0" Stroke="#60718C" StrokeThickness="1.7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#91B4EC"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#5B96F5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#CFDBEB" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,4,0,0"><ScrollViewer MaxHeight="280" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="DropDownToggle" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Height" Value="24"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid VerticalAlignment="Center">
     <Track x:Name="PART_Track" Height="18" VerticalAlignment="Center">
      <Track.DecreaseRepeatButton><RepeatButton IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" Background="#3985F4" CornerRadius="3" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid><Ellipse Fill="#D8E8FF"/><Ellipse Width="11" Height="11" Fill="#2D7EF2"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" Background="#DCE5F1" CornerRadius="3" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#FAFCFF"/><Setter Property="BorderBrush" Value="#DDE6F2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#FAFCFF"/><Setter Property="BorderBrush" Value="#DDE6F2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF2F8"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFD"/></Style>
  <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="#2B7EF3"/><Setter Property="Background" Value="#DFE8F4"/></Style>
 </Window.Resources>

 <Border x:Name="WindowBorder" CornerRadius="16" BorderBrush="#C9D5E5" BorderThickness="1" Background="#F3F7FD" ClipToBounds="True">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>

   <Border x:Name="SidebarBorder" Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" CornerRadius="15,0,0,15">
    <Grid Margin="0,30,0,22"><Grid.RowDefinitions><RowDefinition Height="112"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid Margin="28,0,18,0"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="∞" FontFamily="Segoe UI" FontSize="54" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,-8,0,0">
       <TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4A8FFF"/><GradientStop Color="#5EE6F7" Offset="1"/></LinearGradientBrush></TextBlock.Foreground>
      </TextBlock>
      <StackPanel Grid.Column="1" Margin="4,10,0,0"><TextBlock Text="工具箱" Foreground="White" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="让效率触手可及" Foreground="#91A8C6" FontSize="12" Margin="0,6,0,0"/></StackPanel>
     </Grid>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Button x:Name="TimerNav" Style="{StaticResource NavButton}" Click="TimerNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="23" Width="42"/><TextBlock Text="倒计时" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="PomodoroNav" Style="{StaticResource NavButton}" Click="PomodoroNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="20" Width="42"/><TextBlock Text="番茄钟" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="MouseNav" Style="{StaticResource NavButton}" Click="MouseNav_Click" BorderBrush="#58D8FF"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2875E8"/><GradientStop Color="#244F9B" Offset="1"/></LinearGradientBrush></Button.Background><StackPanel Orientation="Horizontal"><TextBlock Text="◎" FontSize="23" Width="42"/><TextBlock Text="鼠标高亮" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="ClipboardNav" Style="{StaticResource NavButton}" Click="ClipboardNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontSize="20" Width="42"/><TextBlock Text="剪贴板历史" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="NotesNav" Style="{StaticResource NavButton}" Click="NotesNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="20" Width="42"/><TextBlock Text="便签 / 待办" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="OrganizerNav" Style="{StaticResource NavButton}" Click="OrganizerNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="20" Width="42"/><TextBlock Text="桌面收纳" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="RenameNav" Style="{StaticResource NavButton}" Click="RenameNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="✎" FontSize="21" Width="42"/><TextBlock Text="批量重命名" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="ImageNav" Style="{StaticResource NavButton}" Click="ImageNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▧" FontSize="20" Width="42"/><TextBlock Text="图片处理" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="PdfNav" Style="{StaticResource NavButton}" Click="PdfNav_Click"><StackPanel Orientation="Horizontal"><Border Width="30" Height="22" CornerRadius="3" Background="#DCE9FA" Margin="0,0,12,0"><TextBlock Text="PDF" FontSize="9" FontWeight="Bold" Foreground="#16375F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="PDF 工具" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="SettingsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="21" Width="42"/><TextBlock Text="设置与更新" VerticalAlignment="Center"/></StackPanel></Button>
     </StackPanel></ScrollViewer>
     <StackPanel Grid.Row="2" Margin="31,12,0,0"><TextBlock Text="v1.1.1" Foreground="#8FA6C5" FontSize="12"/><TextBlock Text="简单实用 · 高效生活" Foreground="#7189AA" FontSize="11" Margin="0,6,0,0"/></StackPanel>
    </Grid>
   </Border>

   <Grid Grid.Column="1" Background="#F5F8FD">
    <TextBlock Text="工具箱" Foreground="#9AA8BD" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="—" Style="{StaticResource TitleButton}" Click="MinimizeWindow_Click"/>
     <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource TitleButton}" Click="MaximizeWindow_Click"/>
     <Button Content="×" Style="{StaticResource CloseTitleButton}" Click="CloseWindow_Click"/>
    </StackPanel>
   </Grid>

   <Grid Grid.Column="1" Grid.Row="1" Margin="32,4,32,26">
    <ScrollViewer x:Name="MousePage" VerticalScrollBarVisibility="Auto">
     <StackPanel>
      <Grid Height="134" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
       <Grid Width="82" Height="82" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Ellipse Fill="#E7F0FF"/><Ellipse Width="61" Height="61" Fill="#C9DCFF"/><Ellipse Width="37" Height="37" Fill="#3D84F7"/><Ellipse Width="15" Height="15" Fill="White"/>
       </Grid>
       <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="鼠标高亮" Style="{StaticResource PageTitle}"/><TextBlock Text="演示时快速定位鼠标，并支持屏幕标注。" Style="{StaticResource PageSubtitle}"/></StackPanel>
       <Canvas Grid.Column="2" Height="125" ClipToBounds="False">
        <Ellipse Width="150" Height="150" Fill="#EAF2FF" Opacity="0.6" Canvas.Left="22" Canvas.Top="-20"/>
        <Ellipse Width="94" Height="94" Fill="#D9E8FF" Opacity="0.8" Canvas.Left="50" Canvas.Top="8"/>
        <Ellipse Width="48" Height="48" Fill="#4C96FF" Opacity="0.88" Canvas.Left="73" Canvas.Top="31"/>
        <Path Data="M 105,55 L 105,110 L 119,96 L 132,121 L 144,115 L 132,90 L 153,90 Z" Fill="#17243A" Stroke="White" StrokeThickness="3"/>
        <TextBlock Text="让演示更清晰" Foreground="#A1AEC2" FontSize="15" FontStyle="Italic" Canvas.Left="177" Canvas.Top="41" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform Angle="-9"/></TextBlock.RenderTransform></TextBlock>
       </Canvas>
      </Grid>

      <Border Style="{StaticResource Card}" Margin="0,0,0,16" Padding="26,22">
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#9BA7B9" Margin="0,0,14,0"/><TextBlock x:Name="StatusText" Text="当前状态：未启用" FontSize="17" FontWeight="SemiBold" Foreground="#14223A"/></StackPanel><TextBlock Text="启用后将在屏幕上显示鼠标高亮效果" Foreground="#7C8AA2" Margin="26,8,10,0" TextWrapping="Wrap"/></StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
         <Button x:Name="EnableButton" Content="▶  启用高亮    F1" Click="EnableButton_Click" Style="{StaticResource PrimaryButton}" Height="50" MinWidth="170"/>
         <Button x:Name="DisableButton" Content="■  关闭高亮    F1" Click="DisableButton_Click" IsEnabled="False" Style="{StaticResource ActionButton}" Height="50" MinWidth="160"/>
         <Button x:Name="AnnotationButton" Content="✎  屏幕标注    F2" Click="AnnotationButton_Click" Style="{StaticResource ActionButton}" Height="50" MinWidth="160"/>
        </WrapPanel>
       </Grid>
      </Border>

      <Border Style="{StaticResource Card}" Padding="26,22">
       <StackPanel>
        <DockPanel Margin="0,0,0,12"><Border Width="36" Height="36" CornerRadius="18" Background="#EDF4FF"><TextBlock Text="⚙" FontSize="19" Foreground="#36577F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="外观设置" Style="{StaticResource CardTitle}" Margin="13,0,0,0" VerticalAlignment="Center"/><TextBlock Text="自定义鼠标高亮的显示效果" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="58"/><RowDefinition Height="58"/><RowDefinition Height="58"/><RowDefinition Height="58"/></Grid.RowDefinitions>
         <TextBlock Text="◔   主题" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ThemeBox" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="0" SelectionChanged="Settings_Changed"><ComboBoxItem Content="经典纯色"/><ComboBoxItem Content="聚光高亮"/><ComboBoxItem Content="霓虹效果"/></ComboBox>
         <TextBlock Grid.Row="1" Text="◯   形状" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ShapeBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="0" SelectionChanged="Settings_Changed"><ComboBoxItem Content="圆环"/><ComboBoxItem Content="方框"/><ComboBoxItem Content="十字准星"/></ComboBox>
         <TextBlock Grid.Row="2" Text="⌗   大小" Style="{StaticResource FieldLabel}"/><Slider x:Name="SizeSlider" Grid.Row="2" Grid.Column="1" Minimum="24" Maximum="72" Value="32" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="Settings_Changed" VerticalAlignment="Center"/><TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="2" Text="32 px" Foreground="#405575" VerticalAlignment="Center" HorizontalAlignment="Right"/>
         <TextBlock Grid.Row="3" Text="⌾   位置" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PositionBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="0" SelectionChanged="Settings_Changed"><ComboBoxItem Content="环绕鼠标"/><ComboBoxItem Content="鼠标右下方"/><ComboBoxItem Content="鼠标左上方"/></ComboBox>
         <TextBlock Grid.Row="4" Text="◒   颜色" Style="{StaticResource FieldLabel}"/><StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"><Button x:Name="ColorButton" Content="选择颜色" Click="ColorButton_Click" Style="{StaticResource ActionButton}" Margin="0" MinWidth="126"/><Border x:Name="ColorPreview" Width="66" Height="30" CornerRadius="6" Background="Red" Margin="12,0,0,0" VerticalAlignment="Center" BorderBrush="#D6DFEC" BorderThickness="1"/><TextBlock x:Name="ColorHexText" Text="#FF0000" Foreground="#526785" VerticalAlignment="Center" Margin="18,0,0,0"/></StackPanel>
        </Grid>
        <Border Height="1" Background="#E7EDF6" Margin="0,10,0,18"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><CheckBox x:Name="DynamicCheck" Content="动态呼吸效果" FontWeight="SemiBold" Checked="Settings_Changed" Unchecked="Settings_Changed"/><TextBlock Text="高亮圈按呼吸动画效果显示" Style="{StaticResource MutedText}" Margin="24,7,0,0"/></StackPanel>
         <StackPanel Grid.Column="1"><CheckBox x:Name="KeyboardCheck" Content="按键提示" FontWeight="SemiBold" Checked="KeyboardCheck_Changed" Unchecked="KeyboardCheck_Changed"/><TextBlock Text="在屏幕上显示快捷键提示" Style="{StaticResource MutedText}" Margin="24,7,0,0"/></StackPanel>
        </Grid>
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>

    <ScrollViewer x:Name="TimerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TimerPanel">
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#E8F1FF" VerticalAlignment="Center"><TextBlock Text="◷" FontSize="34" Foreground="#2C78ED" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="倒计时" Style="{StaticResource PageTitle}"/><TextBlock Text="开启可拖动、可缩放、始终置顶的悬浮计时器。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="设置倒计时时长" Style="{StaticResource CardTitle}"/><TextBlock Text="归零后会继续显示红色负计时，适合演讲和会议控时。" Style="{StaticResource MutedText}" Margin="0,7,0,18"/><StackPanel Orientation="Horizontal"><TextBox x:Name="TimerMinutes" Text="10" Width="110" Height="48" FontSize="20" TextAlignment="Center"/><TextBlock Text="分钟" VerticalAlignment="Center" Margin="12,0,28,0"/><TextBox x:Name="TimerSeconds" Text="0" Width="110" Height="48" FontSize="20" TextAlignment="Center"/><TextBlock Text="秒" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><WrapPanel Margin="0,20,0,0"><Button Content="▶  启动倒计时" Click="StartTimer_Click" Style="{StaticResource PrimaryButton}"/><Button Content="开始 / 暂停" Click="ToggleTimer_Click" Style="{StaticResource ActionButton}"/><Button Content="重置" Click="ResetTimer_Click" Style="{StaticResource ActionButton}"/></WrapPanel><StackPanel x:Name="TimerBackgroundHost"/></StackPanel></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="PomodoroPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#FFF0F1" VerticalAlignment="Center"><TextBlock Text="●" FontSize="30" Foreground="#E54D59" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="番茄钟" Style="{StaticResource PageTitle}"/><TextBlock Text="专注、短休息和长休息自动循环，时间到后托盘提醒。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock x:Name="PomodoroStageText" Text="准备专注" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#293A55"/><TextBlock x:Name="PomodoroTimeText" Text="25:00" FontSize="70" FontWeight="Light" Foreground="#E5484D" HorizontalAlignment="Center" Margin="0,12"/><ProgressBar x:Name="PomodoroProgress" Height="9" Minimum="0" Maximum="100" Value="0"/><WrapPanel HorizontalAlignment="Center" Margin="0,18,0,0"><Button x:Name="PomodoroStartButton" Content="开始" Click="PomodoroStart_Click" Style="{StaticResource PrimaryButton}"/><Button Content="重置" Click="PomodoroReset_Click" Style="{StaticResource ActionButton}"/><Button Content="跳到下一阶段" Click="PomodoroSkip_Click" Style="{StaticResource ActionButton}"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="7"><TextBlock Text="专注（分钟）" Style="{StaticResource MutedText}"/><TextBox x:Name="PomodoroWorkMinutes" Text="25" Height="40" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Margin="7"><TextBlock Text="短休息" Style="{StaticResource MutedText}"/><TextBox x:Name="PomodoroShortMinutes" Text="5" Height="40" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel><StackPanel Grid.Column="2" Margin="7"><TextBlock Text="长休息" Style="{StaticResource MutedText}"/><TextBox x:Name="PomodoroLongMinutes" Text="15" Height="40" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel><StackPanel Grid.Column="3" Margin="7"><TextBlock Text="每轮番茄数" Style="{StaticResource MutedText}"/><TextBox x:Name="PomodoroRoundCount" Text="4" Height="40" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel></Grid></Border><TextBlock x:Name="PomodoroCountText" Text="今日已完成 0 个番茄" Style="{StaticResource MutedText}" Margin="4,14,0,0"/>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="ClipboardPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#EAF4FF" VerticalAlignment="Center"><TextBlock Text="▣" FontSize="30" Foreground="#2B79EF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="剪贴板历史" Style="{StaticResource PageTitle}"/><TextBlock Text="仅保存在本机，记录最近 100 条文本。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><DockPanel Margin="0,0,0,12"><CheckBox x:Name="ClipboardMonitorCheck" Content="启用记录" IsChecked="True" Checked="ClipboardMonitorCheck_Changed" Unchecked="ClipboardMonitorCheck_Changed" FontWeight="SemiBold"/><TextBlock x:Name="ClipboardCountText" Text="0 条" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/></DockPanel><ListBox x:Name="ClipboardList" Height="430" SelectionChanged="ClipboardList_SelectionChanged" MouseDoubleClick="ClipboardList_MouseDoubleClick"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="7"><TextBlock Text="{Binding DisplayText}" TextWrapping="NoWrap" Foreground="#263750"/><TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="#8A99AF" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="内容预览" Style="{StaticResource CardTitle}"/><TextBox x:Name="ClipboardPreview" Height="378" Margin="0,12,0,12" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Padding="12"/><WrapPanel><Button Content="复制所选" Click="CopyClipboardEntry_Click" Style="{StaticResource PrimaryButton}"/><Button Content="删除所选" Click="DeleteClipboardEntry_Click" Style="{StaticResource ActionButton}"/><Button Content="清空历史" Click="ClearClipboardHistory_Click" Style="{StaticResource DangerButton}"/></WrapPanel></StackPanel></Grid></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="NotesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#FFF6DD" VerticalAlignment="Center"><TextBlock Text="▤" FontSize="30" Foreground="#D49A21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="桌面便签 / 待办" Style="{StaticResource PageTitle}"/><TextBlock Text="记录待办，并可显示为始终置顶的桌面便签。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><ListBox x:Name="NotesList" Height="410" SelectionChanged="NotesList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid Margin="7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#263750" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#7B8AA4" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="＋  新建便签" Click="NewNote_Click" Style="{StaticResource ActionButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="标题" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NoteTitleBox" Height="40" Margin="0,7,0,14"/><TextBlock Text="内容" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NoteContentBox" Height="248" Margin="0,7,0,14" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10"/><CheckBox x:Name="NoteDoneCheck" Content="标记为已完成"/><WrapPanel Margin="0,14,0,0"><Button Content="保存" Click="SaveNote_Click" Style="{StaticResource PrimaryButton}"/><Button Content="显示桌面便签" Click="ShowStickyNote_Click" Style="{StaticResource ActionButton}"/><Button Content="删除" Click="DeleteNote_Click" Style="{StaticResource DangerButton}"/></WrapPanel></StackPanel></Grid></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="OrganizerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#E9F9F3" VerticalAlignment="Center"><TextBlock Text="▦" FontSize="30" Foreground="#20A374" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="桌面收纳" Style="{StaticResource PageTitle}"/><TextBlock Text="将桌面办公文档整理到当天日期文件夹，可随时撤回。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="安全整理" Style="{StaticResource CardTitle}"/><TextBlock Text="支持 Word、Excel、PowerPoint、PDF、TXT、CSV、WPS 等文档；不会移动程序、快捷方式或文件夹。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,18"/><Border Background="#F2F7FD" Padding="16" CornerRadius="9" BorderBrush="#E1EAF5" BorderThickness="1"><TextBlock x:Name="OrganizerStatus" Text="正在读取桌面…" TextWrapping="Wrap" Foreground="#405575"/></Border><WrapPanel Margin="0,18,0,0"><Button Content="预览待整理文件" Click="PreviewOrganize_Click" Style="{StaticResource ActionButton}"/><Button Content="执行收纳" Click="Organize_Click" Style="{StaticResource PrimaryButton}"/><Button Content="撤回上一次" Click="UndoOrganize_Click" Style="{StaticResource ActionButton}"/></WrapPanel><ListBox x:Name="OrganizerPreview" Height="260" Margin="4,16,4,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="RenamePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#F0EDFF" VerticalAlignment="Center"><TextBlock Text="✎" FontSize="32" Foreground="#7359D9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="文件批量重命名" Style="{StaticResource PageTitle}"/><TextBlock Text="先预览并检查冲突，确认后再一次性重命名。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}"><StackPanel><WrapPanel><Button Content="选择文件" Click="SelectRenameFiles_Click" Style="{StaticResource PrimaryButton}"/><Button Content="选择文件夹" Click="SelectRenameFolder_Click" Style="{StaticResource ActionButton}"/><TextBlock x:Name="RenameSelectionText" Text="尚未选择文件" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0"/></WrapPanel><Grid Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="5"><TextBlock Text="查找" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RenameFindBox" Margin="0,7,0,0" TextChanged="RenameRule_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="5"><TextBlock Text="替换为" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RenameReplaceBox" Margin="0,7,0,0" TextChanged="RenameRule_Changed"/></StackPanel><StackPanel Grid.Column="2" Margin="5"><TextBlock Text="前缀" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RenamePrefixBox" Margin="0,7,0,0" TextChanged="RenameRule_Changed"/></StackPanel><StackPanel Grid.Column="3" Margin="5"><TextBlock Text="后缀" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RenameSuffixBox" Margin="0,7,0,0" TextChanged="RenameRule_Changed"/></StackPanel></Grid><WrapPanel Margin="5,0,0,12"><CheckBox x:Name="RenameRegexCheck" Content="使用正则表达式" Checked="RenameRule_Changed" Unchecked="RenameRule_Changed" Margin="0,0,26,0"/><CheckBox x:Name="RenameNumberCheck" Content="追加三位序号" Checked="RenameRule_Changed" Unchecked="RenameRule_Changed"/><TextBlock Text="起始" Margin="26,0,8,0" VerticalAlignment="Center"/><TextBox x:Name="RenameNumberStart" Text="1" Width="66" Height="30" TextAlignment="Center" TextChanged="RenameRule_Changed"/></WrapPanel><DataGrid x:Name="RenamePreviewGrid" Height="300" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="原名称" Binding="{Binding OldName}" Width="*"/><DataGridTextColumn Header="新名称" Binding="{Binding NewName}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="120"/></DataGrid.Columns></DataGrid><Button Content="执行重命名" Click="ApplyRename_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,14,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="ImagePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#EAF7FF" VerticalAlignment="Center"><TextBlock Text="▧" FontSize="30" Foreground="#2687C7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="图片压缩与格式转换" Style="{StaticResource PageTitle}"/><TextBlock Text="批量转换格式、调整质量和尺寸，始终生成新文件。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}"><StackPanel><WrapPanel><Button Content="选择图片" Click="SelectImages_Click" Style="{StaticResource PrimaryButton}"/><Button Content="选择输出目录" Click="SelectImageOutput_Click" Style="{StaticResource ActionButton}"/><TextBlock x:Name="ImageSelectionText" Text="尚未选择图片" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0"/></WrapPanel><Grid Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="6"><TextBlock Text="输出格式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ImageFormatBox" SelectedIndex="0" Margin="0,8,0,0"><ComboBoxItem Content="JPEG"/><ComboBoxItem Content="PNG"/><ComboBoxItem Content="BMP"/><ComboBoxItem Content="TIFF"/><ComboBoxItem Content="GIF"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="6"><TextBlock Text="JPEG 质量" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal" Margin="0,11,0,0"><Slider x:Name="ImageQualitySlider" Minimum="20" Maximum="100" Value="82" Width="190" ValueChanged="ImageQualitySlider_Changed"/><TextBlock x:Name="ImageQualityText" Text="82" Width="42" TextAlignment="Right" Foreground="#405575"/></StackPanel></StackPanel><StackPanel Grid.Column="2" Margin="6"><TextBlock Text="最长边像素（0=原尺寸）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ImageMaxEdgeBox" Text="0" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel></Grid><TextBlock x:Name="ImageOutputText" Text="输出目录：自动创建“工具箱-图片输出”" Style="{StaticResource MutedText}" Margin="6,0,0,12" TextWrapping="Wrap"/><ProgressBar x:Name="ImageProgress" Height="10" Minimum="0" Maximum="100"/><WrapPanel Margin="0,14,0,0"><Button x:Name="ImageConvertButton" Content="▶  开始处理" Click="ConvertImages_Click" Style="{StaticResource PrimaryButton}"/><TextBlock x:Name="ImageStatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#405575"/></WrapPanel></StackPanel></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="PdfPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#F2F5FA" VerticalAlignment="Center"><TextBlock Text="PDF" FontSize="17" FontWeight="Bold" Foreground="#36516F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="PDF 工具" Style="{StaticResource PageTitle}"/><TextBlock Text="本地完成合并、拆分、页面提取和旋转，不上传文件。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,8,8"><StackPanel><TextBlock Text="合并 PDF" Style="{StaticResource CardTitle}"/><TextBlock Text="按选择顺序把多个 PDF 合并为一个文件。" Style="{StaticResource MutedText}" Margin="0,7,0,16" TextWrapping="Wrap"/><Button Content="选择并合并" Click="MergePdf_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="8,0,0,8"><StackPanel><TextBlock Text="拆分 PDF" Style="{StaticResource CardTitle}"/><TextBlock Text="把一个 PDF 的每一页保存为独立文件。" Style="{StaticResource MutedText}" Margin="0,7,0,16" TextWrapping="Wrap"/><Button Content="选择并拆分" Click="SplitPdf_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,8,8,0"><StackPanel><TextBlock Text="提取页面" Style="{StaticResource CardTitle}"/><TextBlock Text="页码示例：1-3,5,8-10" Style="{StaticResource MutedText}" Margin="0,7,0,9"/><TextBox x:Name="PdfRangeBox" Text="1-3" Margin="0,0,0,12"/><Button Content="选择并提取" Click="ExtractPdf_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="8,8,0,0"><StackPanel><TextBlock Text="旋转页面" Style="{StaticResource CardTitle}"/><TextBlock Text="旋转全部页面并另存为新 PDF。" Style="{StaticResource MutedText}" Margin="0,7,0,9"/><ComboBox x:Name="PdfRotateBox" SelectedIndex="0" Margin="0,0,0,12"><ComboBoxItem Content="顺时针 90°" Tag="90"/><ComboBoxItem Content="180°" Tag="180"/><ComboBoxItem Content="逆时针 90°" Tag="270"/></ComboBox><Button Content="选择并旋转" Click="RotatePdf_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/></StackPanel></Border></UniformGrid><Border Background="#EAF3FF" CornerRadius="9" Padding="15" Margin="0,16,0,0" BorderBrush="#D7E6F9" BorderThickness="1"><TextBlock x:Name="PdfStatusText" Text="准备就绪。加密或损坏的 PDF 可能无法处理。" Foreground="#3B5B88" TextWrapping="Wrap"/></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#EDF2F8" VerticalAlignment="Center"><TextBlock Text="⚙" FontSize="31" Foreground="#49617F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="设置与更新" Style="{StaticResource PageTitle}"/><TextBlock Text="管理托盘行为、版本更新和应用信息。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="工具箱 v1.1.1" Style="{StaticResource CardTitle}"/><TextBlock Text="保持应用安静运行，并自动获取后续版本。" Style="{StaticResource MutedText}" Margin="0,7,0,18"/><CheckBox x:Name="MinimizeToTrayCheck" Content="最小化窗口时隐藏到系统托盘" IsChecked="True" Margin="0,0,0,10" Checked="GeneralSetting_Changed" Unchecked="GeneralSetting_Changed"/><CheckBox x:Name="AutoUpdateCheck" Content="启动时自动检查更新" IsChecked="True" Margin="0,0,0,16" Checked="GeneralSetting_Changed" Unchecked="GeneralSetting_Changed"/><Button x:Name="CheckUpdateButton" Content="立即检查更新" Click="CheckUpdateButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/><TextBlock Text="更新由 GitHub Releases 提供。下载时会显示进度、速度和剩余时间，完成后自动安装并重新打开工具箱。" Style="{StaticResource MutedText}" Margin="0,15,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="隐私与数据" Style="{StaticResource CardTitle}"/><TextBlock Text="剪贴板历史和便签只保存在本机 %LOCALAPPDATA%\Toolbox，不会上传网络。PDF 与图片处理也完全在本地完成。" Style="{StaticResource MutedText}" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </Grid>
  </Grid>
 </Border>
</Window>
