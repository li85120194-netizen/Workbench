<Window x:Class="Workbench.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="工具箱" Width="1040" Height="680" MinWidth="900" MinHeight="600"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
 Background="#DCE5F1" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
 Closing="Window_Closing" SourceInitialized="Window_SourceInitialized" StateChanged="Window_StateChanged">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="7" CornerRadius="16"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#10243F" Offset="0"/><GradientStop Color="#153152" Offset="0.58"/><GradientStop Color="#0F2441" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ActiveNavBrush" StartPoint="0,0" EndPoint="1,0">
   <GradientStop Color="#2875E8" Offset="0"/><GradientStop Color="#244F9B" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#3989FF" Offset="0"/><GradientStop Color="#1765EA" Offset="1"/>
  </LinearGradientBrush>

  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Height" Value="38"/><Setter Property="Margin" Value="9,1"/><Setter Property="Padding" Value="13,0"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="#D9E8FC"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="4,0,0,0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="NavBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
             BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
      <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#24466F"/><Setter Property="Foreground" Value="White"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBorder" Property="Opacity" Value="0.82"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>

  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Height" Value="36"/><Setter Property="MinWidth" Value="96"/><Setter Property="Margin" Value="4"/>
   <Setter Property="Padding" Value="13,0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#324765"/><Setter Property="Background" Value="#FAFCFF"/>
   <Setter Property="BorderBrush" Value="#D7E2F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#80ADFA"/><Setter TargetName="ButtonBorder" Property="Background" Value="#F2F7FF"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
   <Setter Property="BorderBrush" Value="#2070EF"/>
  </Style>
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
   <Setter Property="Foreground" Value="#C83C49"/><Setter Property="Background" Value="#FFF7F8"/><Setter Property="BorderBrush" Value="#F1CCD1"/>
  </Style>
  <Style x:Key="TitleButton" TargetType="Button">
   <Setter Property="Width" Value="48"/><Setter Property="Height" Value="42"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Foreground" Value="#14233A"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="TitleButtonBorder" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TitleButtonBorder" Property="Background" Value="#E6EDF7"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="TitleButtonBorder" Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CloseTitleButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E84555"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
  </Style>

  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Padding" Value="18"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Background" Value="#FCFEFF"/>
   <Setter Property="BorderBrush" Value="#E6EDF7"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#0E1D35"/></Style>
  <Style x:Key="PageSubtitle" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#73829C"/><Setter Property="Margin" Value="0,5,0,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#15233B"/></Style>
  <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="#7B8AA4"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#40516D"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="TextBox">
   <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="11,0"/><Setter Property="FontSize" Value="14"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Foreground" Value="#1B2A42"/><Setter Property="Background" Value="#FAFCFF"/>
   <Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="TextBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TextBoxBorder" Property="BorderBrush" Value="#5B96F5"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="TextBoxBorder" Property="Opacity" Value="0.55"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="9,4"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#1B2A42"/><Setter Property="Background" Value="#FAFCFF"/>
   <Setter Property="BorderBrush" Value="#D8E2F0"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="11,8"/><Setter Property="Foreground" Value="#263750"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#EAF2FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#DCEAFF"/><Setter Property="Foreground" Value="#1765EA"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboBorder" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="8"><Grid><ContentPresenter Margin="12,0,38,0" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/><Path Data="M 0 0 L 5 5 L 10 0" Stroke="#60718C" StrokeThickness="1.7" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#91B4EC"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#5B96F5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#CFDBEB" BorderThickness="1" CornerRadius="8" Padding="5" Margin="0,4,0,0"><ScrollViewer MaxHeight="280" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="DropDownToggle" Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Height" Value="24"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid VerticalAlignment="Center">
     <Track x:Name="PART_Track" Height="18" VerticalAlignment="Center">
      <Track.DecreaseRepeatButton><RepeatButton IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" Background="#3985F4" CornerRadius="3" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid><Ellipse Fill="#D8E8FF"/><Ellipse Width="11" Height="11" Fill="#2D7EF2"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="5" Background="#DCE5F1" CornerRadius="3" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#FAFCFF"/><Setter Property="BorderBrush" Value="#DDE6F2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#FAFCFF"/><Setter Property="BorderBrush" Value="#DDE6F2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EDF2F8"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F8FAFD"/></Style>
  <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="#2B7EF3"/><Setter Property="Background" Value="#DFE8F4"/></Style>
  <Style x:Key="SidebarExpander" TargetType="Expander">
   <Setter Property="Foreground" Value="#AFC6E4"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="7,2"/>
   <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="#8FA9CA" Margin="8,7,0,5"/></DataTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HomeMetricCard" TargetType="Border" BasedOn="{StaticResource Card}"><Setter Property="Margin" Value="5"/><Setter Property="Padding" Value="14"/><Setter Property="Background" Value="#EFFFFFFF"/></Style>
  <Style x:Key="HomeToolButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
   <Setter Property="Width" Value="136"/><Setter Property="Height" Value="72"/><Setter Property="Margin" Value="5"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,0"/>
  </Style>
 </Window.Resources>

 <Border x:Name="WindowBorder" CornerRadius="16" BorderBrush="#C9D5E5" BorderThickness="1" Background="#F3F7FD" ClipToBounds="True">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="184" MinWidth="154" MaxWidth="260"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>

   <Border x:Name="SidebarBorder" Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" CornerRadius="15,0,0,15">
    <Grid Margin="0,14,0,14"><Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Button x:Name="ProfileButton" Grid.Row="2" Click="ProfileButton_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch" Padding="14,5">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid Width="42" Height="42"><Ellipse x:Name="ProfileAvatarShape" Fill="#DCEAFF"/><TextBlock x:Name="ProfileInitialText" Text="登" Foreground="#2D73DC" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock x:Name="ProfileNameText" Text="登录 / 注册" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ProfileHintText" Text="本机账户 · 可选" Foreground="#8FA9CA" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      </Grid>
     </Button>
     <Grid Grid.Row="0" Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="∞" FontFamily="Segoe UI" FontSize="38" FontWeight="SemiBold" VerticalAlignment="Center"><TextBlock.Foreground><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4A8FFF"/><GradientStop Color="#5EE6F7" Offset="1"/></LinearGradientBrush></TextBlock.Foreground></TextBlock>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="工具箱" Foreground="White" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="轻量效率中心" Foreground="#91A8C6" FontSize="10"/></StackPanel>
     </Grid>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <Button x:Name="HomeNav" Style="{StaticResource NavButton}" Click="HomeNav_Click" BorderBrush="#58D8FF"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#2875E8"/><GradientStop Color="#244F9B" Offset="1"/></LinearGradientBrush></Button.Background><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="18" Width="32"/><TextBlock Text="首页" VerticalAlignment="Center"/></StackPanel></Button>
      <Expander x:Name="PresentationExpander" Header="演示工具" Style="{StaticResource SidebarExpander}"><StackPanel>
       <Button x:Name="MouseNav" Style="{StaticResource NavButton}" Click="MouseNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◎" FontSize="18" Width="32"/><TextBlock Text="鼠标高亮" VerticalAlignment="Center"/></StackPanel></Button>
      </StackPanel></Expander>
      <Expander x:Name="TimeExpander" Header="时间管理" Style="{StaticResource SidebarExpander}"><StackPanel>
       <Button x:Name="TimerNav" Style="{StaticResource NavButton}" Click="TimerNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="18" Width="32"/><TextBlock Text="倒计时" VerticalAlignment="Center"/></StackPanel></Button>
       <Button x:Name="PomodoroNav" Style="{StaticResource NavButton}" Click="PomodoroNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="17" Width="32"/><TextBlock Text="番茄钟" VerticalAlignment="Center"/></StackPanel></Button>
      </StackPanel></Expander>
      <Expander x:Name="RecordExpander" Header="记录与待办" Style="{StaticResource SidebarExpander}"><StackPanel>
       <Button x:Name="ClipboardNav" Style="{StaticResource NavButton}" Click="ClipboardNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontSize="16" Width="32"/><TextBlock Text="剪贴板历史" VerticalAlignment="Center"/></StackPanel></Button>
       <Button x:Name="NotesNav" Style="{StaticResource NavButton}" Click="NotesNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="16" Width="32"/><TextBlock Text="便签 / 待办" VerticalAlignment="Center"/></StackPanel></Button>
      </StackPanel></Expander>
      <Expander x:Name="FileExpander" Header="文件处理" Style="{StaticResource SidebarExpander}"><StackPanel>
       <Button x:Name="OrganizerNav" Style="{StaticResource NavButton}" Click="OrganizerNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="16" Width="32"/><TextBlock Text="桌面收纳" VerticalAlignment="Center"/></StackPanel></Button>
       <Button x:Name="RenameNav" Style="{StaticResource NavButton}" Click="RenameNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="✎" FontSize="17" Width="32"/><TextBlock Text="批量重命名" VerticalAlignment="Center"/></StackPanel></Button>
       <Button x:Name="ImageNav" Style="{StaticResource NavButton}" Click="ImageNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▧" FontSize="16" Width="32"/><TextBlock Text="图片处理" VerticalAlignment="Center"/></StackPanel></Button>
       <Button x:Name="PdfNav" Style="{StaticResource NavButton}" Click="PdfNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="PDF" FontSize="9" FontWeight="Bold" Width="32"/><TextBlock Text="PDF 工具" VerticalAlignment="Center"/></StackPanel></Button>
      </StackPanel></Expander>
      <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="SettingsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="17" Width="32"/><TextBlock Text="设置与更新" VerticalAlignment="Center"/></StackPanel></Button>
     </StackPanel></ScrollViewer>
     <StackPanel Grid.Row="3" Margin="18,8,0,0"><TextBlock Text="v1.2.1" Foreground="#8FA6C5" FontSize="11"/></StackPanel>
    </Grid>
   </Border>
   <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" DragCompleted="SidebarSplitter_DragCompleted" ToolTip="拖动调整菜单宽度"/>

   <Grid Grid.Column="2" Background="#F5F8FD">
    <TextBlock x:Name="CurrentPageTitle" Text="首页" Foreground="#8B9AB0" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="11"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="—" Style="{StaticResource TitleButton}" Click="MinimizeWindow_Click"/>
     <Button x:Name="MaximizeButton" Content="□" Style="{StaticResource TitleButton}" Click="MaximizeWindow_Click"/>
     <Button Content="×" Style="{StaticResource CloseTitleButton}" Click="CloseWindow_Click"/>
    </StackPanel>
   </Grid>

   <Grid Grid.Column="2" Grid.Row="1" Margin="20,2,20,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#EAF0F8" BorderBrush="#D6E0ED" BorderThickness="1" CornerRadius="9" Padding="5" Margin="0,0,0,10">
     <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="OpenTabsPanel" Orientation="Horizontal"/></ScrollViewer>
    </Border>
    <Grid Grid.Row="1">
    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Border CornerRadius="16" ClipToBounds="True" MinHeight="590">
      <Grid>
       <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#BFE9F3"/><GradientStop Color="#6BB4CF" Offset="0.48"/><GradientStop Color="#305F82" Offset="1"/></LinearGradientBrush></Grid.Background>
       <Canvas IsHitTestVisible="False" Opacity="0.58">
        <Path Fill="#3B91AB" Data="M0,340 C100,190 170,300 260,180 C350,65 420,280 520,155 C610,45 705,265 820,120 C900,45 980,190 1100,80 L1100,600 L0,600 Z"/>
        <Path Fill="#1F6F89" Opacity="0.7" Data="M0,430 C140,300 210,390 330,265 C460,125 560,410 690,255 C820,100 920,380 1100,235 L1100,620 L0,620 Z"/>
       </Canvas>
       <StackPanel Margin="24,20">
        <StackPanel HorizontalAlignment="Center"><TextBlock x:Name="HomeClockText" Text="--:--" Foreground="White" FontFamily="Segoe UI" FontSize="42" FontWeight="Light" HorizontalAlignment="Center"/><TextBlock x:Name="HomeDateText" Text="正在读取日期" Foreground="#F1FAFF" FontSize="12" HorizontalAlignment="Center"/></StackPanel>
        <Border Background="#CFEAF3" CornerRadius="22" Width="500" MaxWidth="620" Height="42" Margin="0,16,0,15" HorizontalAlignment="Center"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock x:Name="HomeSearchPlaceholder" Text="搜索网页或输入网址" Foreground="#58758B" IsHitTestVisible="False" VerticalAlignment="Center" Margin="18,0"/><TextBox x:Name="HomeSearchBox" Background="Transparent" BorderThickness="0" Padding="18,7" VerticalContentAlignment="Center" KeyDown="HomeSearchBox_KeyDown" TextChanged="HomeSearchBox_TextChanged"/><Button Grid.Column="1" Content="⌕" Background="Transparent" BorderThickness="0" FontSize="20" Foreground="#35566D" Click="SearchButton_Click"/></Grid></Border>
        <UniformGrid Columns="4" Margin="-5,0">
         <Border Style="{StaticResource HomeMetricCard}"><StackPanel><TextBlock Text="番茄钟" Foreground="#6D7D93"/><TextBlock x:Name="HomePomodoroTime" Text="25:00" FontSize="25" FontWeight="SemiBold" Foreground="#1C2B43" Margin="0,5,0,0"/><Button Content="开始专注" Click="HomeStartPomodoro_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left" Margin="-4,7,0,0" Height="30"/></StackPanel></Border>
         <Border Style="{StaticResource HomeMetricCard}"><StackPanel><TextBlock Text="待办便签" Foreground="#6D7D93"/><TextBlock x:Name="HomeNotesCount" Text="0 条" FontSize="25" FontWeight="SemiBold" Foreground="#1C2B43" Margin="0,5,0,0"/><TextBlock Text="本机保存" Foreground="#7C8DA5" FontSize="11"/></StackPanel></Border>
         <Border Style="{StaticResource HomeMetricCard}"><StackPanel><TextBlock Text="剪贴板历史" Foreground="#6D7D93"/><TextBlock x:Name="HomeClipboardCount" Text="0 条" FontSize="25" FontWeight="SemiBold" Foreground="#1C2B43" Margin="0,5,0,0"/><TextBlock Text="最多 100 条" Foreground="#7C8DA5" FontSize="11"/></StackPanel></Border>
         <Border Style="{StaticResource HomeMetricCard}"><StackPanel><TextBlock Text="鼠标高亮" Foreground="#6D7D93"/><TextBlock x:Name="HomeHighlightStatus" Text="未启用" FontSize="25" FontWeight="SemiBold" Foreground="#1C2B43" Margin="0,5,0,0"/><TextBlock Text="快捷键 F1" Foreground="#7C8DA5" FontSize="11"/></StackPanel></Border>
        </UniformGrid>
        <Border Background="#C91A3149" CornerRadius="14" Padding="14" Margin="5,12,5,0">
         <StackPanel><TextBlock Text="全部工具" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="5,0,0,6"/><WrapPanel>
          <Button Style="{StaticResource HomeToolButton}" Click="MouseNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◎" FontSize="25" Foreground="#2E7BEF" Margin="0,0,10,0"/><StackPanel><TextBlock Text="鼠标高亮"/><TextBlock Text="演示与标注" FontSize="10" Foreground="#7B8AA0"/></StackPanel></StackPanel></Button>
          <Button Style="{StaticResource HomeToolButton}" Click="TimerNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="25" Foreground="#2E7BEF" Margin="0,0,10,0"/><StackPanel><TextBlock Text="倒计时"/><TextBlock Text="桌面控时" FontSize="10" Foreground="#7B8AA0"/></StackPanel></StackPanel></Button>
