<Window x:Class="Workbench.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="工具箱" Width="1160" Height="760" MinWidth="1040" MinHeight="680"
 WindowStartupLocation="CenterScreen" Background="#F4F6FA" Closing="Window_Closing"
 SourceInitialized="Window_SourceInitialized" StateChanged="Window_StateChanged">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button"><Setter Property="Height" Value="44"/><Setter Property="Margin" Value="12,2"/><Setter Property="Padding" Value="16,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="#DDE4F0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Height" Value="40"/><Setter Property="MinWidth" Value="112"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="14,0"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Padding" Value="20"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="White"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="TextBox"><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#182033">
   <Grid Margin="0,16,0,14"><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel HorizontalAlignment="Center"><TextBlock Text="∞" FontSize="42" Foreground="#66D9FF" HorizontalAlignment="Center"/><TextBlock Text="工具箱" FontSize="18" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,-9,0,0"/></StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Button x:Name="TimerNav" Content="◷  倒计时" Style="{StaticResource NavButton}" Click="TimerNav_Click"/>
     <Button x:Name="PomodoroNav" Content="●  番茄钟" Style="{StaticResource NavButton}" Click="PomodoroNav_Click"/>
     <Button x:Name="MouseNav" Content="◉  鼠标高亮" Style="{StaticResource NavButton}" Click="MouseNav_Click" Background="#2B3854"/>
     <Button x:Name="ClipboardNav" Content="▣  剪贴板历史" Style="{StaticResource NavButton}" Click="ClipboardNav_Click"/>
     <Button x:Name="NotesNav" Content="▤  便签 / 待办" Style="{StaticResource NavButton}" Click="NotesNav_Click"/>
     <Button x:Name="OrganizerNav" Content="▦  桌面收纳" Style="{StaticResource NavButton}" Click="OrganizerNav_Click"/>
     <Button x:Name="RenameNav" Content="✎  批量重命名" Style="{StaticResource NavButton}" Click="RenameNav_Click"/>
     <Button x:Name="ImageNav" Content="▧  图片处理" Style="{StaticResource NavButton}" Click="ImageNav_Click"/>
     <Button x:Name="PdfNav" Content="PDF  PDF 工具" Style="{StaticResource NavButton}" Click="PdfNav_Click"/>
     <Button x:Name="SettingsNav" Content="⚙  设置与更新" Style="{StaticResource NavButton}" Click="SettingsNav_Click"/>
    </StackPanel></ScrollViewer>
    <TextBlock Grid.Row="2" Text="v1.1.0" Foreground="#8290A8" HorizontalAlignment="Center" FontSize="12"/>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="28,22">
   <ScrollViewer x:Name="MousePage" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="鼠标高亮" FontSize="28" FontWeight="SemiBold" Foreground="#172033"/><TextBlock Text="演示时快速定位鼠标，并支持屏幕标注。" Foreground="#687386" Margin="0,4,0,18"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#9AA0A6" Margin="0,0,9,0"/><TextBlock x:Name="StatusText" Text="当前状态：未启用" FontSize="15"/></StackPanel>
     <WrapPanel Margin="0,14,0,0"><Button x:Name="EnableButton" Content="启用高亮  F1" Click="EnableButton_Click" Style="{StaticResource ActionButton}" Background="#1677FF" Foreground="White"/><Button x:Name="DisableButton" Content="关闭高亮  F1" Click="DisableButton_Click" IsEnabled="False" Style="{StaticResource ActionButton}"/><Button x:Name="AnnotationButton" Content="屏幕标注  F2" Click="AnnotationButton_Click" Style="{StaticResource ActionButton}"/></WrapPanel>
    </StackPanel></Border>
    <Border Margin="0,14,0,0" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/><RowDefinition Height="44"/></Grid.RowDefinitions>
     <TextBlock Text="主题" VerticalAlignment="Center"/><ComboBox x:Name="ThemeBox" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="0" SelectionChanged="Settings_Changed"><ComboBoxItem Content="经典纯色"/><ComboBoxItem Content="聚光高亮"/><ComboBoxItem Content="霓虹效果"/></ComboBox>
     <TextBlock Grid.Row="1" Text="形状" VerticalAlignment="Center"/><ComboBox x:Name="ShapeBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="0" SelectionChanged="Settings_Changed"><ComboBoxItem Content="圆环"/><ComboBoxItem Content="方框"/><ComboBoxItem Content="十字准星"/></ComboBox>
     <TextBlock Grid.Row="2" Text="大小" VerticalAlignment="Center"/><Slider x:Name="SizeSlider" Grid.Row="2" Grid.Column="1" Minimum="24" Maximum="72" Value="32" TickFrequency="4" IsSnapToTickEnabled="True" ValueChanged="Settings_Changed"/><TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="2" Text="32 px" VerticalAlignment="Center" HorizontalAlignment="Right"/>
     <TextBlock Grid.Row="3" Text="位置" VerticalAlignment="Center"/><ComboBox x:Name="PositionBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="0" SelectionChanged="Settings_Changed"><ComboBoxItem Content="环绕鼠标"/><ComboBoxItem Content="鼠标右下方"/><ComboBoxItem Content="鼠标左上方"/></ComboBox>
     <TextBlock Grid.Row="4" Text="颜色" VerticalAlignment="Center"/><Button x:Name="ColorButton" Grid.Row="4" Grid.Column="1" Content="选择颜色…" Click="ColorButton_Click" Height="32" HorizontalAlignment="Left" Padding="14,0"/><Border x:Name="ColorPreview" Grid.Row="4" Grid.Column="2" Width="34" Height="24" CornerRadius="4" Background="Red" HorizontalAlignment="Right"/>
     <CheckBox x:Name="DynamicCheck" Grid.Row="5" Grid.Column="1" Content="动态呼吸效果" Checked="Settings_Changed" Unchecked="Settings_Changed"/><CheckBox x:Name="KeyboardCheck" Grid.Row="5" Grid.Column="2" Content="按键显示" Checked="KeyboardCheck_Changed" Unchecked="KeyboardCheck_Changed" HorizontalAlignment="Right"/>
    </Grid></Border>
   </StackPanel></ScrollViewer>

   <ScrollViewer x:Name="TimerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TimerPanel">
    <TextBlock Text="倒计时" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="开启一个可拖动、可缩放、始终置顶的悬浮计时器。" Foreground="#687386" Margin="0,4,0,18"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="设置时长" FontSize="18" FontWeight="SemiBold"/>
     <StackPanel Orientation="Horizontal" Margin="0,18"><TextBox x:Name="TimerMinutes" Text="10" Width="90" Height="42" FontSize="20" TextAlignment="Center"/><TextBlock Text="分钟" VerticalAlignment="Center" Margin="10,0,22,0"/><TextBox x:Name="TimerSeconds" Text="0" Width="90" Height="42" FontSize="20" TextAlignment="Center"/><TextBlock Text="秒" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
     <WrapPanel><Button Content="启动倒计时" Click="StartTimer_Click" Style="{StaticResource ActionButton}" Background="#17A673" Foreground="White"/><Button Content="开始 / 暂停" Click="ToggleTimer_Click" Style="{StaticResource ActionButton}"/><Button Content="重置" Click="ResetTimer_Click" Style="{StaticResource ActionButton}"/></WrapPanel>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>

   <ScrollViewer x:Name="PomodoroPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="番茄钟" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="专注、短休息和长休息自动循环，时间到后托盘提醒。" Foreground="#687386" Margin="0,4,0,18"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock x:Name="PomodoroStageText" Text="准备专注" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
     <TextBlock x:Name="PomodoroTimeText" Text="25:00" FontSize="64" FontWeight="Light" Foreground="#E5484D" HorizontalAlignment="Center" Margin="0,12"/>
     <ProgressBar x:Name="PomodoroProgress" Height="8" Minimum="0" Maximum="100" Value="0"/>
     <WrapPanel HorizontalAlignment="Center" Margin="0,16,0,0"><Button x:Name="PomodoroStartButton" Content="开始" Click="PomodoroStart_Click" Style="{StaticResource ActionButton}" Background="#E5484D" Foreground="White"/><Button Content="重置" Click="PomodoroReset_Click" Style="{StaticResource ActionButton}"/><Button Content="跳到下一阶段" Click="PomodoroSkip_Click" Style="{StaticResource ActionButton}"/></WrapPanel>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel Margin="4"><TextBlock Text="专注（分钟）" Foreground="#687386"/><TextBox x:Name="PomodoroWorkMinutes" Text="25" Height="36" Margin="0,7,0,0" TextAlignment="Center"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="短休息" Foreground="#687386"/><TextBox x:Name="PomodoroShortMinutes" Text="5" Height="36" Margin="0,7,0,0" TextAlignment="Center"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="长休息" Foreground="#687386"/><TextBox x:Name="PomodoroLongMinutes" Text="15" Height="36" Margin="0,7,0,0" TextAlignment="Center"/></StackPanel>
     <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="每轮番茄数" Foreground="#687386"/><TextBox x:Name="PomodoroRoundCount" Text="4" Height="36" Margin="0,7,0,0" TextAlignment="Center"/></StackPanel>
    </Grid></Border>
    <TextBlock x:Name="PomodoroCountText" Text="今日已完成 0 个番茄" Foreground="#687386" Margin="4,14,0,0"/>
   </StackPanel></ScrollViewer>

   <ScrollViewer x:Name="ClipboardPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="剪贴板历史" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="仅保存在本机，记录最近 100 条文本；双击或点击按钮即可重新复制。" Foreground="#687386" Margin="0,4,0,18"/>
    <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,14,0">
      <DockPanel Margin="0,0,0,10"><CheckBox x:Name="ClipboardMonitorCheck" Content="启用记录" IsChecked="True" Checked="ClipboardMonitorCheck_Changed" Unchecked="ClipboardMonitorCheck_Changed"/><TextBlock x:Name="ClipboardCountText" Text="0 条" Foreground="#687386" HorizontalAlignment="Right"/></DockPanel>
      <ListBox x:Name="ClipboardList" Height="430" SelectionChanged="ClipboardList_SelectionChanged" MouseDoubleClick="ClipboardList_MouseDoubleClick"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding DisplayText}" TextWrapping="NoWrap"/><TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="#8A94A5" Margin="0,3,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     </StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="内容预览" FontWeight="SemiBold"/><TextBox x:Name="ClipboardPreview" Height="380" Margin="0,10,0,10" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Padding="10"/>
      <WrapPanel><Button Content="复制所选" Click="CopyClipboardEntry_Click" Style="{StaticResource ActionButton}" Background="#1677FF" Foreground="White"/><Button Content="删除所选" Click="DeleteClipboardEntry_Click" Style="{StaticResource ActionButton}"/><Button Content="清空历史" Click="ClearClipboardHistory_Click" Style="{StaticResource ActionButton}"/></WrapPanel>
     </StackPanel>
    </Grid></Border>
   </StackPanel></ScrollViewer>

   <ScrollViewer x:Name="NotesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="桌面便签 / 待办" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="记录待办，并可把任意一条显示为始终置顶的桌面便签。" Foreground="#687386" Margin="0,4,0,18"/>
    <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,16,0"><ListBox x:Name="NotesList" Height="410" SelectionChanged="NotesList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#687386" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="新建便签" Click="NewNote_Click" Style="{StaticResource ActionButton}" Margin="0,10,0,0"/></StackPanel>
     <StackPanel Grid.Column="1"><TextBlock Text="标题" Foreground="#687386"/><TextBox x:Name="NoteTitleBox" Height="38" Margin="0,6,0,12"/><TextBlock Text="内容" Foreground="#687386"/><TextBox x:Name="NoteContentBox" Height="250" Margin="0,6,0,12" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="8"/><CheckBox x:Name="NoteDoneCheck" Content="标记为已完成"/>
      <WrapPanel Margin="0,12,0,0"><Button Content="保存" Click="SaveNote_Click" Style="{StaticResource ActionButton}" Background="#1677FF" Foreground="White"/><Button Content="显示桌面便签" Click="ShowStickyNote_Click" Style="{StaticResource ActionButton}"/><Button Content="删除" Click="DeleteNote_Click" Style="{StaticResource ActionButton}"/></WrapPanel>
     </StackPanel>
    </Grid></Border>
   </StackPanel></ScrollViewer>

   <ScrollViewer x:Name="OrganizerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="桌面收纳" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="将桌面办公文档整理到当天日期文件夹，可随时撤回上一次操作。" Foreground="#687386" Margin="0,4,0,18"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock Text="安全整理" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="支持 Word、Excel、PowerPoint、PDF、TXT、CSV、WPS 等文档；不会移动文件夹、隐藏文件、程序或快捷方式。" Foreground="#687386" TextWrapping="Wrap" Margin="0,8,0,16"/>
     <Border Background="#F4F7FB" Padding="14" CornerRadius="8"><TextBlock x:Name="OrganizerStatus" Text="正在读取桌面…" TextWrapping="Wrap"/></Border>
     <WrapPanel Margin="0,16,0,0"><Button Content="预览待整理文件" Click="PreviewOrganize_Click" Style="{StaticResource ActionButton}"/><Button Content="执行收纳" Click="Organize_Click" Style="{StaticResource ActionButton}" Background="#1677FF" Foreground="White"/><Button Content="撤回上一次" Click="UndoOrganize_Click" Style="{StaticResource ActionButton}"/></WrapPanel>
     <ListBox x:Name="OrganizerPreview" Height="260" Margin="4,14,4,0"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>

   <ScrollViewer x:Name="RenamePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="文件批量重命名" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="先生成预览并检查冲突，确认后再一次性重命名。" Foreground="#687386" Margin="0,4,0,18"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <WrapPanel><Button Content="选择文件" Click="SelectRenameFiles_Click" Style="{StaticResource ActionButton}"/><Button Content="选择文件夹" Click="SelectRenameFolder_Click" Style="{StaticResource ActionButton}"/><TextBlock x:Name="RenameSelectionText" Text="尚未选择文件" Foreground="#687386" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
     <Grid Margin="0,14,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="4"><TextBlock Text="查找" Foreground="#687386"/><TextBox x:Name="RenameFindBox" Height="34" Margin="0,5,0,0" TextChanged="RenameRule_Changed"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="替换为" Foreground="#687386"/><TextBox x:Name="RenameReplaceBox" Height="34" Margin="0,5,0,0" TextChanged="RenameRule_Changed"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="前缀" Foreground="#687386"/><TextBox x:Name="RenamePrefixBox" Height="34" Margin="0,5,0,0" TextChanged="RenameRule_Changed"/></StackPanel>
      <StackPanel Grid.Column="3" Margin="4"><TextBlock Text="后缀" Foreground="#687386"/><TextBox x:Name="RenameSuffixBox" Height="34" Margin="0,5,0,0" TextChanged="RenameRule_Changed"/></StackPanel>
     </Grid>
     <WrapPanel Margin="4,0,0,10"><CheckBox x:Name="RenameRegexCheck" Content="使用正则表达式" Checked="RenameRule_Changed" Unchecked="RenameRule_Changed" Margin="0,0,24,0"/><CheckBox x:Name="RenameNumberCheck" Content="追加三位序号" Checked="RenameRule_Changed" Unchecked="RenameRule_Changed"/><TextBlock Text="起始" Margin="24,0,8,0"/><TextBox x:Name="RenameNumberStart" Text="1" Width="60" Height="28" TextAlignment="Center" TextChanged="RenameRule_Changed"/></WrapPanel>
     <DataGrid x:Name="RenamePreviewGrid" Height="300" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="原名称" Binding="{Binding OldName}" Width="*"/><DataGridTextColumn Header="新名称" Binding="{Binding NewName}" Width="*"/><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110"/></DataGrid.Columns></DataGrid>
     <Button Content="执行重命名" Click="ApplyRename_Click" Style="{StaticResource ActionButton}" Background="#1677FF" Foreground="White" HorizontalAlignment="Right" Margin="0,12,0,0"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>

   <ScrollViewer x:Name="ImagePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="图片压缩与格式转换" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="批量转换 JPEG、PNG、BMP、TIFF、GIF，可限制最长边；始终生成新文件。" Foreground="#687386" Margin="0,4,0,18"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <WrapPanel><Button Content="选择图片" Click="SelectImages_Click" Style="{StaticResource ActionButton}"/><Button Content="选择输出目录" Click="SelectImageOutput_Click" Style="{StaticResource ActionButton}"/><TextBlock x:Name="ImageSelectionText" Text="尚未选择图片" Foreground="#687386" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
     <Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="4"><TextBlock Text="输出格式" Foreground="#687386"/><ComboBox x:Name="ImageFormatBox" SelectedIndex="0" Margin="0,6,0,0"><ComboBoxItem Content="JPEG"/><ComboBoxItem Content="PNG"/><ComboBoxItem Content="BMP"/><ComboBoxItem Content="TIFF"/><ComboBoxItem Content="GIF"/></ComboBox></StackPanel>
      <StackPanel Grid.Column="1" Margin="4"><TextBlock Text="JPEG 质量" Foreground="#687386"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Slider x:Name="ImageQualitySlider" Minimum="20" Maximum="100" Value="82" Width="180" ValueChanged="ImageQualitySlider_Changed"/><TextBlock x:Name="ImageQualityText" Text="82" Width="38" TextAlignment="Right"/></StackPanel></StackPanel>
      <StackPanel Grid.Column="2" Margin="4"><TextBlock Text="最长边像素（0=原尺寸）" Foreground="#687386"/><TextBox x:Name="ImageMaxEdgeBox" Text="0" Height="34" Margin="0,6,0,0" TextAlignment="Center"/></StackPanel>
     </Grid>
     <TextBlock x:Name="ImageOutputText" Text="输出目录：自动创建“工具箱-图片输出”" Foreground="#687386" Margin="4,0,0,10" TextWrapping="Wrap"/>
     <ProgressBar x:Name="ImageProgress" Height="10" Minimum="0" Maximum="100"/>
     <WrapPanel Margin="0,12,0,0"><Button x:Name="ImageConvertButton" Content="开始处理" Click="ConvertImages_Click" Style="{StaticResource ActionButton}" Background="#17A673" Foreground="White"/><TextBlock x:Name="ImageStatusText" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
    </StackPanel></Border>
   </StackPanel></ScrollViewer>

   <ScrollViewer x:Name="PdfPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="PDF 工具" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="本地完成合并、拆分、提取页面和旋转，不上传文件。" Foreground="#687386" Margin="0,4,0,18"/>
    <UniformGrid Columns="2">
     <Border Style="{StaticResource Card}" Margin="0,0,7,7"><StackPanel><TextBlock Text="合并 PDF" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="按选择顺序把多个 PDF 合并为一个文件。" Foreground="#687386" Margin="0,6,0,14" TextWrapping="Wrap"/><Button Content="选择并合并" Click="MergePdf_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="7,0,0,7"><StackPanel><TextBlock Text="拆分 PDF" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="把一个 PDF 的每一页保存为独立文件。" Foreground="#687386" Margin="0,6,0,14" TextWrapping="Wrap"/><Button Content="选择并拆分" Click="SplitPdf_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="0,7,7,0"><StackPanel><TextBlock Text="提取页面" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="页码示例：1-3,5,8-10" Foreground="#687386" Margin="0,6,0,8"/><TextBox x:Name="PdfRangeBox" Text="1-3" Height="34" Margin="0,0,0,10"/><Button Content="选择并提取" Click="ExtractPdf_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/></StackPanel></Border>
     <Border Style="{StaticResource Card}" Margin="7,7,0,0"><StackPanel><TextBlock Text="旋转页面" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="旋转全部页面并另存为新 PDF。" Foreground="#687386" Margin="0,6,0,8"/><ComboBox x:Name="PdfRotateBox" SelectedIndex="0" Margin="0,0,0,10"><ComboBoxItem Content="顺时针 90°" Tag="90"/><ComboBoxItem Content="180°" Tag="180"/><ComboBoxItem Content="逆时针 90°" Tag="270"/></ComboBox><Button Content="选择并旋转" Click="RotatePdf_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/></StackPanel></Border>
    </UniformGrid>
    <Border Background="#EEF5FF" CornerRadius="8" Padding="14" Margin="0,16,0,0"><TextBlock x:Name="PdfStatusText" Text="准备就绪。加密或损坏的 PDF 可能无法处理。" Foreground="#3B5B88" TextWrapping="Wrap"/></Border>
   </StackPanel></ScrollViewer>

   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="设置与更新" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="管理托盘行为、版本更新和应用信息。" Foreground="#687386" Margin="0,4,0,18"/>
