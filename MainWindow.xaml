     <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="7"><TextBlock Text="专注（分钟）" Style="{StaticResource MutedText}"/><TextBox x:Name="PomodoroWorkMinutes" Text="25" Height="40" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Margin="7"><TextBlock Text="短休息" Style="{StaticResource MutedText}"/><TextBox x:Name="PomodoroShortMinutes" Text="5" Height="40" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel><StackPanel Grid.Column="2" Margin="7"><TextBlock Text="长休息" Style="{StaticResource MutedText}"/><TextBox x:Name="PomodoroLongMinutes" Text="15" Height="40" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel><StackPanel Grid.Column="3" Margin="7"><TextBlock Text="每轮番茄数" Style="{StaticResource MutedText}"/><TextBox x:Name="PomodoroRoundCount" Text="4" Height="40" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel></Grid></Border><TextBlock x:Name="PomodoroCountText" Text="今日已完成 0 个番茄" Style="{StaticResource MutedText}" Margin="4,14,0,0"/>
    </StackPanel></ScrollViewer>

    <Grid x:Name="ClipboardPage" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="4,5,4,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="剪贴板历史" Style="{StaticResource PageTitle}"/>
       <TextBlock Text="快速找回复制过的文本，内容仅保存在本机。" Style="{StaticResource PageSubtitle}"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#EAF3FF" CornerRadius="9" Padding="12,7" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#2C7BEF" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="ClipboardCountText" Text="0 条记录" Foreground="#31577F" FontSize="12"/></StackPanel>
      </Border>
     </Grid>

     <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

       <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
         <TextBlock Text="历史记录" FontSize="15" FontWeight="SemiBold" Foreground="#2E2630" VerticalAlignment="Center"/>
         <CheckBox x:Name="ClipboardMonitorCheck" Content="自动记录" IsChecked="True" Checked="ClipboardMonitorCheck_Changed" Unchecked="ClipboardMonitorCheck_Changed" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="ClipboardList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                 ItemContainerStyle="{StaticResource ClipboardHistoryItem}"
                 SelectionChanged="ClipboardList_SelectionChanged" MouseDoubleClick="ClipboardList_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
         <ListBox.ItemTemplate><DataTemplate>
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" Foreground="#263750" FontSize="13"/>
           <TextBlock Grid.Row="1" Text="{Binding TimeText}" FontSize="10" Foreground="#8A99AF" Margin="0,6,0,0"/>
          </Grid>
         </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
       </Grid>

       <Border Grid.Column="1" Background="#E7EDF5"/>

       <Grid Grid.Column="2" Margin="18,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12">
         <StackPanel>
          <TextBlock Text="内容预览" FontSize="15" FontWeight="SemiBold" Foreground="#2E2630"/>
          <TextBlock Text="选择左侧记录查看完整内容，双击可直接复制。" FontSize="11" Foreground="#8492A6" Margin="0,4,0,0"/>
         </StackPanel>
        </DockPanel>
        <TextBox x:Name="ClipboardPreview" Grid.Row="1" Margin="0" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" IsReadOnly="True" Padding="14"
                 Background="#F8FAFD"/>
        <Grid Grid.Row="2" Margin="0,14,0,0">
         <StackPanel Orientation="Horizontal">
          <Button Content="复制内容" Click="CopyClipboardEntry_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
          <Button Content="删除记录" Click="DeleteClipboardEntry_Click" Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
         </StackPanel>
         <Button Content="清空全部" Click="ClearClipboardHistory_Click" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" Margin="0"/>
        </Grid>
       </Grid>
      </Grid>
     </Border>
    </Grid>

    <ScrollViewer x:Name="NotesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#FFF0C9" VerticalAlignment="Center"><TextBlock Text="▤" FontSize="30" Foreground="#D49A21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="桌面便签 / 待办" Style="{StaticResource PageTitle}"/><TextBlock Text="记录待办，并可显示为始终置顶的桌面便签。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><ListBox x:Name="NotesList" Height="370" SelectionChanged="NotesList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid Margin="7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#263750" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="#82747C" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="＋  新建便签" Click="NewNote_Click" Style="{StaticResource ActionButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="标题" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NoteTitleBox" Height="40" Margin="0,7,0,14"/><TextBlock Text="内容" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NoteContentBox" Height="220" Margin="0,7,0,14" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Padding="10"/><CheckBox x:Name="NoteDoneCheck" Content="标记为已完成"/><WrapPanel Margin="0,14,0,0"><Button Content="保存" Click="SaveNote_Click" Style="{StaticResource PrimaryButton}"/><Button Content="显示桌面便签" Click="ShowStickyNote_Click" Style="{StaticResource ActionButton}"/><Button Content="删除" Click="DeleteNote_Click" Style="{StaticResource DangerButton}"/></WrapPanel></StackPanel></Grid></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="OrganizerPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#E9F9F3" VerticalAlignment="Center"><TextBlock Text="▦" FontSize="30" Foreground="#20A374" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="桌面收纳" Style="{StaticResource PageTitle}"/><TextBlock Text="将桌面办公文档整理到当天日期文件夹，可随时撤回。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="安全整理" Style="{StaticResource CardTitle}"/><TextBlock Text="支持 Word、Excel、PowerPoint、PDF、TXT、CSV、WPS 等文档；不会移动程序、快捷方式或文件夹。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,18"/><Border Background="#F2F7FD" Padding="16" CornerRadius="9" BorderBrush="#E1EAF5" BorderThickness="1"><TextBlock x:Name="OrganizerStatus" Text="正在读取桌面…" TextWrapping="Wrap" Foreground="#405575"/></Border><WrapPanel Margin="0,18,0,0"><Button Content="预览待整理文件" Click="PreviewOrganize_Click" Style="{StaticResource ActionButton}"/><Button Content="执行收纳" Click="Organize_Click" Style="{StaticResource PrimaryButton}"/><Button Content="撤回上一次" Click="UndoOrganize_Click" Style="{StaticResource ActionButton}"/></WrapPanel><ListBox x:Name="OrganizerPreview" Height="260" Margin="4,16,4,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="RenamePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#F0EDFF" VerticalAlignment="Center"><TextBlock Text="✎" FontSize="32" Foreground="#7359D9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="文件批量重命名" Style="{StaticResource PageTitle}"/><TextBlock Text="先预览并检查冲突，确认后再一次性重命名。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}"><StackPanel><WrapPanel><Button Content="选择文件" Click="SelectRenameFiles_Click" Style="{StaticResource PrimaryButton}"/><Button Content="选择文件夹" Click="SelectRenameFolder_Click" Style="{StaticResource ActionButton}"/><TextBlock x:Name="RenameSelectionText" Text="尚未选择文件" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0"/></WrapPanel><Grid Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="5"><TextBlock Text="查找" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RenameFindBox" Margin="0,7,0,0" TextChanged="RenameRule_Changed"/></StackPanel><StackPanel Grid.Column="1" Margin="5"><TextBlock Text="替换为" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RenameReplaceBox" Margin="0,7,0,0" TextChanged="RenameRule_Changed"/></StackPanel><StackPanel Grid.Column="2" Margin="5"><TextBlock Text="前缀" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RenamePrefixBox" Margin="0,7,0,0" TextChanged="RenameRule_Changed"/></StackPanel><StackPanel Grid.Column="3" Margin="5"><TextBlock Text="后缀" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RenameSuffixBox" Margin="0,7,0,0" TextChanged="RenameRule_Changed"/></StackPanel></Grid><WrapPanel Margin="5,0,0,12"><CheckBox x:Name="RenameRegexCheck" Content="使用正则表达式" Checked="RenameRule_Changed" Unchecked="RenameRule_Changed" Margin="0,0,26,0"/><CheckBox x:Name="RenameNumberCheck" Content="追加三位序号" Checked="RenameRule_Changed" Unchecked="RenameRule_Changed"/><TextBlock Text="起始" Margin="26,0,8,0" VerticalAlignment="Center"/><TextBox x:Name="RenameNumberStart" Text="1" Width="66" Height="30" TextAlignment="Center" TextChanged="RenameRule_Changed"/></WrapPanel><DataGrid x:Name="RenamePreviewGrid" Height="300" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SizeChanged="RenamePreviewGrid_SizeChanged"><DataGrid.Columns><DataGridTextColumn Header="原名称" Binding="{Binding OldName}"/><DataGridTextColumn Header="新名称" Binding="{Binding NewName}"/><DataGridTextColumn Header="状态" Binding="{Binding Status}"/></DataGrid.Columns></DataGrid><Button Content="执行重命名" Click="ApplyRename_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,14,0,0"/></StackPanel></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="ImagePage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#EAF7FF" VerticalAlignment="Center"><TextBlock Text="▧" FontSize="30" Foreground="#2687C7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="图片压缩与格式转换" Style="{StaticResource PageTitle}"/><TextBlock Text="批量转换格式、调整质量和尺寸，始终生成新文件。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}"><StackPanel><WrapPanel><Button Content="选择图片" Click="SelectImages_Click" Style="{StaticResource PrimaryButton}"/><Button Content="选择输出目录" Click="SelectImageOutput_Click" Style="{StaticResource ActionButton}"/><TextBlock x:Name="ImageSelectionText" Text="尚未选择图片" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0"/></WrapPanel><Grid Margin="0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="6"><TextBlock Text="输出格式" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ImageFormatBox" SelectedIndex="0" Margin="0,8,0,0"><ComboBoxItem Content="JPEG"/><ComboBoxItem Content="PNG"/><ComboBoxItem Content="BMP"/><ComboBoxItem Content="TIFF"/><ComboBoxItem Content="GIF"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="6"><TextBlock Text="JPEG 质量" Style="{StaticResource FieldLabel}"/><StackPanel Orientation="Horizontal" Margin="0,11,0,0"><Slider x:Name="ImageQualitySlider" Minimum="20" Maximum="100" Value="82" Width="190" ValueChanged="ImageQualitySlider_Changed"/><TextBlock x:Name="ImageQualityText" Text="82" Width="42" TextAlignment="Right" Foreground="#405575"/></StackPanel></StackPanel><StackPanel Grid.Column="2" Margin="6"><TextBlock Text="最长边像素（0=原尺寸）" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ImageMaxEdgeBox" Text="0" Margin="0,8,0,0" TextAlignment="Center"/></StackPanel></Grid><TextBlock x:Name="ImageOutputText" Text="输出目录：自动创建“小二-图片输出”" Style="{StaticResource MutedText}" Margin="6,0,0,12" TextWrapping="Wrap"/><ProgressBar x:Name="ImageProgress" Height="10" Minimum="0" Maximum="100"/><WrapPanel Margin="0,14,0,0"><Button x:Name="ImageConvertButton" Content="▶  开始处理" Click="ConvertImages_Click" Style="{StaticResource PrimaryButton}"/><TextBlock x:Name="ImageStatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#405575"/></WrapPanel></StackPanel></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="PdfPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#F2F5FA" VerticalAlignment="Center"><TextBlock Text="PDF" FontSize="17" FontWeight="Bold" Foreground="#36516F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="PDF 工具" Style="{StaticResource PageTitle}"/><TextBlock Text="本地完成合并、拆分、页面提取和旋转，不上传文件。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,8,8"><StackPanel><TextBlock Text="合并 PDF" Style="{StaticResource CardTitle}"/><TextBlock Text="按选择顺序把多个 PDF 合并为一个文件。" Style="{StaticResource MutedText}" Margin="0,7,0,16" TextWrapping="Wrap"/><Button Content="选择并合并" Click="MergePdf_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="8,0,0,8"><StackPanel><TextBlock Text="拆分 PDF" Style="{StaticResource CardTitle}"/><TextBlock Text="把一个 PDF 的每一页保存为独立文件。" Style="{StaticResource MutedText}" Margin="0,7,0,16" TextWrapping="Wrap"/><Button Content="选择并拆分" Click="SplitPdf_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,8,8,0"><StackPanel><TextBlock Text="提取页面" Style="{StaticResource CardTitle}"/><TextBlock Text="页码示例：1-3,5,8-10" Style="{StaticResource MutedText}" Margin="0,7,0,9"/><TextBox x:Name="PdfRangeBox" Text="1-3" Margin="0,0,0,12"/><Button Content="选择并提取" Click="ExtractPdf_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="8,8,0,0"><StackPanel><TextBlock Text="旋转页面" Style="{StaticResource CardTitle}"/><TextBlock Text="旋转全部页面并另存为新 PDF。" Style="{StaticResource MutedText}" Margin="0,7,0,9"/><ComboBox x:Name="PdfRotateBox" SelectedIndex="0" Margin="0,0,0,12"><ComboBoxItem Content="顺时针 90°" Tag="90"/><ComboBoxItem Content="180°" Tag="180"/><ComboBoxItem Content="逆时针 90°" Tag="270"/></ComboBox><Button Content="选择并旋转" Click="RotatePdf_Click" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/></StackPanel></Border></UniformGrid><Border Background="#EAF3FF" CornerRadius="9" Padding="15" Margin="0,16,0,0" BorderBrush="#D7E6F9" BorderThickness="1"><TextBlock x:Name="PdfStatusText" Text="准备就绪。加密或损坏的 PDF 可能无法处理。" Foreground="#3B5B88" TextWrapping="Wrap"/></Border>
    </StackPanel></ScrollViewer>

    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Grid Height="112" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="70" Height="70" CornerRadius="35" Background="#EDF2F8" VerticalAlignment="Center"><TextBlock Text="⚙" FontSize="31" Foreground="#49617F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="设置与更新" Style="{StaticResource PageTitle}"/><TextBlock Text="管理托盘行为、版本更新和应用信息。" Style="{StaticResource PageSubtitle}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="小二 v1.3.4" Style="{StaticResource CardTitle}"/><TextBlock Text="保持应用安静运行，并自动获取后续版本。" Style="{StaticResource MutedText}" Margin="0,7,0,18"/><CheckBox x:Name="MinimizeToTrayCheck" Content="最小化窗口时隐藏到系统托盘" IsChecked="True" Margin="0,0,0,10" Checked="GeneralSetting_Changed" Unchecked="GeneralSetting_Changed"/><CheckBox x:Name="AutoUpdateCheck" Content="启动时自动检查更新" IsChecked="True" Margin="0,0,0,16" Checked="GeneralSetting_Changed" Unchecked="GeneralSetting_Changed"/><Button x:Name="CheckUpdateButton" Content="立即检查更新" Click="CheckUpdateButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/><TextBlock Text="更新由 GitHub Releases 提供。下载时会显示进度、速度和剩余时间，完成后自动安装并重新打开小二。" Style="{StaticResource MutedText}" Margin="0,15,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="隐私与数据" Style="{StaticResource CardTitle}"/><TextBlock Text="剪贴板、便签、本机账户、头像和个人设置只保存在 %LOCALAPPDATA%\Toolbox，不会上传网络。PDF 与图片处理也完全在本地完成。" Style="{StaticResource MutedText}" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    </StackPanel></ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
