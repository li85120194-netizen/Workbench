<Window x:Class="Workbench.OperationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="运营内容配置" Width="860" Height="520" WindowStartupLocation="CenterOwner" Background="#F5F8FD"><Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="运营内容配置" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="配置行业视野中展示的网址卡片。内容只保存在本机。" Foreground="#6D7E96" Margin="0,6,0,18"/></StackPanel><DataGrid x:Name="LinksGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding Links}" RowHeight="38"><DataGrid.Columns><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="60"/><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/><DataGridTextColumn Header="简介" Binding="{Binding Description}" Width="*"/><DataGridTextColumn Header="链接" Binding="{Binding Url}" Width="230"/><DataGridTextColumn Header="排序" Binding="{Binding SortOrder}" Width="65"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="新增卡片" Click="Add_Click" Padding="16,8" Margin="0,0,8,0"/><Button Content="删除选中" Click="Delete_Click" Padding="16,8" Margin="0,0,8,0"/><Button Content="保存配置" Click="Save_Click" Padding="16,8" Background="#2875E8" Foreground="White"/></StackPanel></Grid></Window>