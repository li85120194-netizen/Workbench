<Window x:Class="Workbench.IndustryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="行业视野" Width="1040" Height="680" MinWidth="760" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#F5F8FD"><Window.Resources><Style x:Key="LinkCard" TargetType="Button"><Setter Property="Margin" Value="7"/><Setter Property="Padding" Value="16"/><Setter Property="Height" Value="112"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5EBF4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#F7FAFF"/><Setter TargetName="Card" Property="BorderBrush" Value="#8DB5F4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources><Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="7,0,7,17"><StackPanel><TextBlock Text="行业视野" FontSize="28" FontWeight="SemiBold" Foreground="#14233A"/><TextBlock Text="精选运营、产品、商业与设计内容，点击卡片在浏览器打开。" Margin="0,6,0,0" Foreground="#71829A"/></StackPanel><Button Content="内容配置" Click="Configure_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="16,9" Background="#2875E8" Foreground="White" BorderThickness="0" Cursor="Hand"/></DockPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="LinksItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Width="225" Style="{StaticResource LinkCard}" Tag="{Binding Url}" Click="Link_Click"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Border Width="34" Height="34" CornerRadius="17" Background="#E8F1FF"><TextBlock Text="●" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2875E8"/></Border><TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Foreground="#24344D" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Grid.Row="1" Text="{Binding Description}" Margin="0,11,0,0" Foreground="#7A899E" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid></Window>