<Window x:Class="Workbench.AnnotationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp">
    <Grid>
        <Canvas x:Name="DrawingCanvas" Background="Transparent"/>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                Background="#CC202124" CornerRadius="8" Padding="14,8">
            <TextBlock Text="标注模式：按住鼠标左键绘制 · F2 退出" Foreground="White" FontSize="13"/>
        </Border>
    </Grid>
</Window>
